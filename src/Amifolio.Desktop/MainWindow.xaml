<Window x:Class="Amifolio.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Amifolio · 作品集">
 <Grid x:Name="Root" Background="#F6F3EC" Loaded="OnLoaded">
  <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition Height="*" /></Grid.RowDefinitions>
  <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="{StaticResource Paper}">
   <Grid x:Name="TitleDragArea" Padding="20,0,160,0">
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Border x:Name="BrandIcon" Width="18" Height="18" CornerRadius="3"><Border.Background><ImageBrush ImageSource="Assets/Brand.png" Stretch="UniformToFill" /></Border.Background></Border>
     <TextBlock Text="Amifolio" FontFamily="Georgia" FontSize="16" LineHeight="18" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="208" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Border Background="#EFECE4" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
    <Grid Padding="12,20,12,12" RowSpacing="16">
     <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="4">
       <TextBlock Text="作品集" Foreground="{StaticResource Accent}" FontSize="12" Margin="16,0,0,8" />
       <Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Tag="library" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{Binding Foreground, ElementName=LibraryNav}" /><TextBlock Text="全部作品" Foreground="{Binding Foreground, ElementName=LibraryNav}" /></StackPanel></Button>
       <Button x:Name="ProjectsNav" Style="{StaticResource NavButton}" Tag="projects" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{Binding Foreground, ElementName=ProjectsNav}" /><TextBlock Text="项目" Foreground="{Binding Foreground, ElementName=ProjectsNav}" /></StackPanel></Button>
       <TextBlock Text="AI" Foreground="{StaticResource Accent}" FontSize="12" Margin="16,22,0,8" />
       <Button x:Name="ContextNav" Style="{StaticResource NavButton}" Tag="context" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE70B;" FontSize="16" Foreground="{Binding Foreground, ElementName=ContextNav}" /><TextBlock Text="风格与记忆" Foreground="{Binding Foreground, ElementName=ContextNav}" /></StackPanel></Button>
       <Button x:Name="HelpNav" Style="{StaticResource NavButton}" Tag="help" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="12"><Viewbox Width="16" Height="16"><Path Width="16" Height="16" Stroke="{Binding Foreground, ElementName=HelpNav}" StrokeThickness="1.2" Data="M4,4 L12,4 L12,12 L4,12 Z M6,6 L10,6 L10,10 L6,10 Z M6,1 L6,4 M10,1 L10,4 M6,12 L6,15 M10,12 L10,15 M1,6 L4,6 M1,10 L4,10 M12,6 L15,6 M12,10 L15,10" /></Viewbox><TextBlock Text="AI 配置" Foreground="{Binding Foreground, ElementName=HelpNav}" /></StackPanel></Button>
       <Button x:Name="AgentsNav" Style="{StaticResource NavButton}" Tag="agents" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE943;" FontSize="16" Foreground="{Binding Foreground, ElementName=AgentsNav}" /><TextBlock Text="AGENTS.md" Foreground="{Binding Foreground, ElementName=AgentsNav}" /></StackPanel></Button>
       <Button x:Name="ConnectionsNav" Style="{StaticResource NavButton}" Tag="connections" Click="Navigate"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE71B;" FontSize="16" Foreground="{Binding Foreground, ElementName=ConnectionsNav}" /><TextBlock Text="Agent 接入" Foreground="{Binding Foreground, ElementName=ConnectionsNav}" /></StackPanel></Button>
      </StackPanel>
     </ScrollViewer>
     <Button x:Name="SettingsNav" Grid.Row="1" Style="{StaticResource NavButton}" Tag="settings" Click="Navigate" Width="40" Height="40" Padding="9,8,8,8" HorizontalAlignment="Left" HorizontalContentAlignment="Center" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置"><FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{Binding Foreground, ElementName=SettingsNav}" /></Button>
    </Grid>
   </Border>
   <Grid Grid.Column="1">
    <Grid x:Name="LibraryPage">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="278" /></Grid.ColumnDefinitions>
     <Grid Padding="28,26,26,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Grid>
       <TextBlock Text="作品集" Style="{StaticResource PageHeading}" />
       <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="导入代码库" Click="ImportRepository" AutomationProperties.Name="导入代码库" />
        <Button x:Name="ImportButton" Content="＋ 导入文件" Background="{StaticResource Accent}" Foreground="White" Click="ImportFiles" />
       </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,12,0,12" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="126" /></Grid.ColumnDefinitions>
       <TextBox x:Name="SearchBox" PlaceholderText="搜索作品、内容或标签" TextChanged="SearchChanged" AutomationProperties.Name="搜索作品" />
       <ComboBox x:Name="KindFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="FiltersChanged" AutomationProperties.Name="作品类型" />
      </Grid>
      <Grid Grid.Row="2" Margin="0,0,0,16" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <ComboBox x:Name="ProjectFilter" DisplayMemberPath="Name" SelectionChanged="FiltersChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="项目筛选" />
       <ComboBox x:Name="SourceFilter" Grid.Column="1" SelectionChanged="FiltersChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="来源筛选"><x:String>全部来源</x:String><x:String>用户</x:String><x:String>Agent</x:String><x:String>应用</x:String></ComboBox>
       <TextBlock x:Name="LibraryCount" Grid.Column="2" Style="{StaticResource Caption}" VerticalAlignment="Center" />
      </Grid>
      <Grid Grid.Row="3">
       <ListView x:Name="ArtifactList" SelectionChanged="ArtifactSelected" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" Padding="0" AutomationProperties.Name="作品列表">
        <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,9" /><Setter Property="MinHeight" Value="84" /><Setter Property="CornerRadius" Value="5" /></Style></ListView.ItemContainerStyle>
        <ListView.ItemTemplate><DataTemplate>
         <Border Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="16,17">
          <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
           <Border Width="38" Height="40" Background="{StaticResource AccentTint}" CornerRadius="4" VerticalAlignment="Center"><TextBlock Text="{Binding Badge}" FontFamily="Georgia" FontSize="10" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
           <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="{Binding Title}" FontSize="15" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" MaxLines="1" /></StackPanel>
           <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
          </Grid>
         </Border>
        </DataTemplate></ListView.ItemTemplate>
       </ListView>
       <StackPanel x:Name="EmptyLibrary" Spacing="14" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
        <FontIcon Glyph="&#xE8B7;" FontSize="36" Foreground="{StaticResource Accent}" />
        <TextBlock x:Name="EmptyTitle" Text="暂无作品" FontSize="20" TextAlignment="Center" TextWrapping="Wrap" />
        <Button Content="导入文件" Click="ImportFiles" HorizontalAlignment="Center" />
       </StackPanel>
      </Grid>
     </Grid>
     <Border Grid.Column="1" Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
      <ScrollViewer><StackPanel x:Name="DetailContent" Padding="22,30,22,24" Spacing="17">
       <TextBlock Text="作品详情" Style="{StaticResource Caption}" Foreground="{StaticResource Accent}" />
       <TextBlock x:Name="DetailTitle" Text="未选择作品" FontSize="20" TextWrapping="Wrap" />
       <TextBlock x:Name="DetailMetadata" Style="{StaticResource Caption}" />
       <Border x:Name="DetailDivider" Height="1" Background="{StaticResource Line}" Margin="0,4" Visibility="Collapsed" />
       <TextBlock x:Name="DetailPreviewHeading" Text="内容预览" FontSize="14" Visibility="Collapsed" />
       <TextBlock x:Name="DetailPreview" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" IsTextSelectionEnabled="True" MaxHeight="270" />
       <StackPanel x:Name="DetailActions" Spacing="9" Visibility="Collapsed">
        <TextBox x:Name="EditTitle" Header="作品名称" /><TextBox x:Name="EditTags" Header="标签（逗号分隔）" />
        <ComboBox x:Name="EditProject" Header="所属项目" DisplayMemberPath="Name" HorizontalAlignment="Stretch" />
        <Button Content="保存修改" Click="SaveArtifact" HorizontalAlignment="Stretch" />
        <Button Content="显示文件副本" Click="RevealArtifact" HorizontalAlignment="Stretch" />
        <Button Content="从作品集移除" Click="RemoveArtifact" HorizontalAlignment="Stretch" Foreground="#9A5345" />
       </StackPanel>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
    <Grid x:Name="ProjectsPage" Visibility="Collapsed" Padding="32,28">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <Grid><TextBlock Text="项目" Style="{StaticResource PageHeading}" /><Button Content="＋ 新建项目" HorizontalAlignment="Right" VerticalAlignment="Center" Click="CreateProject" Background="{StaticResource Accent}" Foreground="White" /></Grid>
     <ListView x:Name="ProjectsList" Grid.Row="2" SelectionMode="None" HorizontalContentAlignment="Stretch"><ListView.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Paper}" CornerRadius="5" Padding="22" Margin="0,0,0,12"><StackPanel Spacing="10"><TextBlock Text="{Binding Name}" FontSize="20" /><TextBlock Text="{Binding RootPath}" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" /><TextBlock Text="{Binding Id}" Style="{StaticResource Caption}" IsTextSelectionEnabled="True" /></StackPanel></Border></DataTemplate></ListView.ItemTemplate></ListView>
    </Grid>
    <Grid x:Name="ContextPage" Visibility="Collapsed" Padding="32,28">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="风格与记忆" Style="{StaticResource PageHeading}" />
     <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,6,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <ComboBox x:Name="ContextScope" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="ContextScopeChanged" AutomationProperties.Name="上下文作用域" />
      <Grid Grid.Column="1" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <ToggleSwitch x:Name="ContextEnabled" Header="向 Agent 提供上下文" OnContent="开启" OffContent="关闭" Toggled="ContextEnabledChanged" />
       <ToggleSwitch x:Name="OriginalAccess" Grid.Column="1" Header="提供原件路径" OnContent="开启" OffContent="关闭" Toggled="OriginalAccessChanged" />
      </Grid>
     </Grid>
     <Grid Grid.Row="2" ColumnSpacing="12" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox x:Name="ContextDocument" HorizontalAlignment="Stretch" SelectionChanged="ContextDocumentChanged" AutomationProperties.Name="上下文文档" /><TextBlock x:Name="ContextPath" Grid.Column="1" Style="{StaticResource Caption}" VerticalAlignment="Center" IsTextSelectionEnabled="True" /></Grid>
     <TextBox x:Name="ContextEditor" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" PlaceholderText="输入内容" />
     <StackPanel Grid.Row="4" Spacing="12" Margin="0,14,0,0"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ContextEditButton" Content="修改" Click="ToggleContextEdit" Background="{StaticResource Accent}" Foreground="White" /><Button x:Name="ContextCancelButton" Content="取消" Click="CancelContextEdit" Visibility="Collapsed" /><Button x:Name="ContextDeleteButton" Content="删除" Click="DeleteContext" /><Button x:Name="ContextRefreshButton" Content="刷新来源" Click="PublishContext" /><Button x:Name="ContextGenerateButton" Content="生成候选" Click="GenerateContext" /><Button x:Name="AdoptCandidateButton" Content="采用候选" Click="AdoptCandidate" Visibility="Collapsed" /></StackPanel></StackPanel>
    </Grid>
    <ScrollViewer x:Name="HelpPage" Visibility="Collapsed">
     <StackPanel Padding="32,28" Spacing="14" MaxWidth="930" HorizontalAlignment="Left">
      <TextBlock Text="AI 配置" Style="{StaticResource PageHeading}" />
      <Border Background="{StaticResource AccentTint}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="20">
       <StackPanel Spacing="16" MinWidth="400">
        <TextBlock Text="模型设置" FontSize="20" />
        <TextBlock Text="兼容 Chat Completions。点击“生成候选”后发送作品片段，发送前可预览。" Style="{StaticResource Caption}" />
        <TextBox x:Name="ModelEndpoint" Header="模型服务地址" Text="https://api.openai.com/v1" />
        <TextBox x:Name="ModelName" Header="模型名称" PlaceholderText="填写服务商支持的模型 ID" />
        <PasswordBox x:Name="ModelKey" Header="API Key（关闭应用后清除）" Background="{StaticResource Paper}" CornerRadius="5" FontFamily="SimSun" />
        <ToggleSwitch x:Name="RemoteAllowed" Header="允许发送片段给模型服务" OffContent="关闭" OnContent="开启" />
        <TextBlock Text="生成结果需确认采用后发布。" Style="{StaticResource Caption}" />
       </StackPanel>
      </Border>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="AgentsPage" Visibility="Collapsed" Padding="32,28">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <TextBlock Text="AGENTS.md" Style="{StaticResource PageHeading}" />
     <Grid Grid.Row="1" ColumnSpacing="12" Margin="0,6,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox x:Name="AgentsScope" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="AgentsScopeChanged" /><TextBox x:Name="AgentsPath" Grid.Column="1" PlaceholderText="AGENTS.md 绝对路径" /><Button Grid.Column="2" Content="读取" Click="ReadAgents" /></Grid>
     <TextBlock Grid.Row="2" Text="保存前预览差异，保存时自动备份。" Style="{StaticResource Caption}" Margin="0,0,0,12" />
     <TextBox x:Name="AgentsEditor" Grid.Row="3" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="13" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
     <StackPanel Grid.Row="4" Spacing="12" Margin="0,14,0,0"><TextBlock x:Name="AgentsStatus" Style="{StaticResource Caption}" Text="未读取文件" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="AgentsEditButton" Content="修改" Click="ToggleAgentsEdit" Background="{StaticResource Accent}" Foreground="White" /><Button x:Name="AgentsCancelButton" Content="取消" Click="CancelAgentsEdit" Visibility="Collapsed" /><Button x:Name="PrepareAgentsButton" Content="更新上下文入口" Click="PrepareAgents" IsEnabled="False" /><Button x:Name="UndoAgentsButton" Content="撤销上次保存" Click="UndoAgents" IsEnabled="False" /></StackPanel></StackPanel>
    </Grid>
    <ScrollViewer x:Name="ConnectionsPage" Visibility="Collapsed"><StackPanel Padding="32,28" Spacing="20" MaxWidth="940" HorizontalAlignment="Left">
     <TextBlock Text="Agent 接入" Style="{StaticResource PageHeading}" />
     <Border Background="{StaticResource AccentTint}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="24"><StackPanel Spacing="14"><TextBlock Text="Codex · 本机桥接" FontSize="21" /><TextBlock Text="通过 MCP 或命令行提交文件。" TextWrapping="Wrap" /><TextBlock x:Name="BridgeCommand" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><Button Content="复制 MCP 连接配置" Click="CopyConnection" HorizontalAlignment="Left" /></StackPanel></Border>
     <TextBlock Text="配套 skill 可引导提交文件，不会自动收集全部产物。" Style="{StaticResource Caption}" />
     <TextBlock Text="接入步骤" FontSize="20" /><TextBlock Text="1. 添加 MCP 连接。&#xA;2. 安装配套 skill。&#xA;3. 在 AGENTS.md 页添加上下文入口。" TextWrapping="Wrap" />
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"><StackPanel Padding="32,28" Spacing="20" MaxWidth="900" HorizontalAlignment="Left">
     <TextBlock Text="设置" Style="{StaticResource PageHeading}" />
     <TextBlock Text="数据目录" FontSize="20" /><TextBlock x:Name="StoragePath" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><TextBlock Text="存放作品副本、索引和上下文。" Style="{StaticResource Caption}" />
     <Button Content="打开本机数据目录" Click="OpenStorage" HorizontalAlignment="Left" /><Border Height="1" Background="{StaticResource Line}" />
     <TextBlock Text="关于 Amifolio" FontSize="20" /><TextBlock Text="0.1.3 预览版" />
    </StackPanel></ScrollViewer>
   </Grid>
  </Grid>
  <Border x:Name="OperationNotice" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="420" Margin="20" Padding="16" Background="{StaticResource Paper}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
   <Grid ColumnSpacing="12" RowSpacing="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <Button x:Name="CancelButton" Grid.Column="1" Content="取消任务" Padding="10,5" Visibility="Collapsed" Click="CancelOperation" />
    <ProgressBar x:Name="BusyIndicator" Grid.Row="1" Grid.ColumnSpan="2" MinWidth="160" IsIndeterminate="True" Visibility="Collapsed" Foreground="{StaticResource Accent}" />
   </Grid>
  </Border>
 </Grid>
</Window>
