<Application x:Class="Amifolio.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="using:Microsoft.UI.Xaml.Controls" RequestedTheme="Light">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><controls:XamlControlsResources /></ResourceDictionary.MergedDictionaries>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <SolidColorBrush x:Key="ContentDialogBackground" Color="#FCFAF5" />
     <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FCFAF5" />
     <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#DEDFD6" />
     <SolidColorBrush x:Key="ContentDialogForeground" Color="#303A35" />
     <SolidColorBrush x:Key="ContentDialogSeparatorBorderBrush" Color="#DEDFD6" />
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <SolidColorBrush x:Key="Accent" Color="#24766D" />
   <SolidColorBrush x:Key="Ink" Color="#303A35" />
   <SolidColorBrush x:Key="Muted" Color="#718078" />
   <SolidColorBrush x:Key="Paper" Color="#FCFAF5" />
   <SolidColorBrush x:Key="Line" Color="#DEDFD6" />
   <SolidColorBrush x:Key="AccentTint" Color="#EAF3EF" />
   <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#24766D" />
   <Color x:Key="SystemAccentColor">#24766D</Color>
   <Color x:Key="SystemAccentColorDark1">#20685F</Color>
   <Color x:Key="SystemAccentColorLight1">#3F8D82</Color>
   <FontFamily x:Key="ContentControlThemeFontFamily">SimSun</FontFamily>
   <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="SimSun" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Style>
   <Style x:Key="Caption" TargetType="TextBlock"><Setter Property="FontFamily" Value="SimSun" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{StaticResource Muted}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
   <Style x:Key="PageHeading" TargetType="TextBlock"><Setter Property="FontFamily" Value="SimSun" /><Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource Accent}" /><Setter Property="Margin" Value="0,6,0,10" /></Style>
   <Style x:Key="NavButton" TargetType="Button"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="13,11,16,11" /><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="CornerRadius" Value="5" /><Setter Property="FontFamily" Value="SimSun" /><Setter Property="FontSize" Value="14" /></Style>
   <Style x:Key="AmifolioDialogStyle" TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
    <Setter Property="Background" Value="{StaticResource Paper}" />
    <Setter Property="Foreground" Value="{StaticResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="FontFamily" Value="SimSun" />
    <Setter Property="RequestedTheme" Value="Light" />
   </Style>
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="5" /><Setter Property="FontFamily" Value="SimSun" /><Setter Property="Padding" Value="14,9" /></Style>
   <Style TargetType="TextBox"><Setter Property="FontFamily" Value="SimSun" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Background" Value="{StaticResource Paper}" /></Style>
   <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="SimSun" /><Setter Property="CornerRadius" Value="5" /><Setter Property="Background" Value="{StaticResource Paper}" /></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
