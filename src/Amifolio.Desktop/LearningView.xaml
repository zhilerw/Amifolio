<UserControl x:Class="Amifolio.Desktop.LearningView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Padding="28,24" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="风格与记忆" Style="{StaticResource PageHeading}"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="刷新"/><Button x:Name="BackButton" Content="返回" Visibility="Collapsed"/></StackPanel></Grid>
  <Grid Grid.Row="1" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="ScopeBox" DisplayMemberPath="Name" HorizontalAlignment="Stretch" AutomationProperties.Name="风格与记忆范围"/><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/><TextBlock x:Name="CoverageText" Style="{StaticResource Caption}" TextWrapping="Wrap"/><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CapacityText" Style="{StaticResource Caption}" VerticalAlignment="Center"/><Button x:Name="HistoryButton" Grid.Column="1" Content="历史记录" Padding="9,3"/></Grid></StackPanel></Grid>
  <Grid Grid.Row="2" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource AccentTint}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5" Padding="16">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
     <TextBlock Text="学习设置" FontSize="19" Foreground="{StaticResource Accent}"/>
     <CheckBox x:Name="CaptureBox" Content="记录本项目会话概述"/>
     <CheckBox x:Name="LearnBox" Content="提炼风格与记忆"/>
     <CheckBox x:Name="ActivateBox" Content="依据充分时自动启用"/>
     <CheckBox x:Name="ShareBox" Content="共享已启用条目"/>
     <CheckBox x:Name="ContributeBox" Content="参与全局偏好提炼"/>
     <ComboBox x:Name="ModeBox" Header="处理方式" HorizontalAlignment="Stretch" SelectedIndex="0"><x:String>会话内 · 无需 Key</x:String><x:String>后台 · 使用 AI 配置</x:String></ComboBox>
     <NumberBox x:Name="BatchBox" Header="每几次概述整合" Minimum="1" Maximum="20" Value="5" SpinButtonPlacementMode="Inline" FontFamily="{StaticResource AppFontFamily}"/>
     <CheckBox x:Name="RemoteBox" Content="允许向所选服务发送概述"/>
     <TextBlock x:Name="ServiceText" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
     <TextBlock Text="共享与学习分别控制。后台只发送授权概述和必要引文，默认等待120秒无新会话活动；全应用每天最多8次。" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
     <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="SaveSettingsButton" Content="修改" Background="{StaticResource Accent}" Foreground="White" IsEnabled="False"/><Button x:Name="CancelSettingsButton" Content="取消" Visibility="Collapsed"/></StackPanel>
     <Button x:Name="ProcessButton" Content="立即整合"/>
     <TextBlock x:Name="SettingsStatus" Style="{StaticResource Caption}" TextWrapping="Wrap"/>
    </StackPanel></ScrollViewer>
   </Border>
   <Grid Grid.Column="1" RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><ComboBox x:Name="KindBox" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.Name="学习内容"><x:String>画像</x:String><x:String>会话概述</x:String><x:String>处理日志</x:String></ComboBox><ComboBox x:Name="StateBox" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" AutomationProperties.Name="条目状态"><x:String>全部状态</x:String><x:String>已启用</x:String><x:String>观察中</x:String><x:String>已停用</x:String></ComboBox></Grid>
    <ListView x:Name="RowsList" Grid.Row="1" HorizontalContentAlignment="Stretch" SelectionMode="Single">
     <ListView.ItemTemplate><DataTemplate><Grid Padding="10,8" RowSpacing="5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding Title}" FontFamily="{StaticResource AppFontFamily}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding State}" FontFamily="{StaticResource AppFontFamily}" Foreground="{StaticResource Accent}" Margin="10,0,0,0"/><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis"/></Grid></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <StackPanel Grid.Row="2" Spacing="6"><TextBlock x:Name="DetailTitle" FontSize="17" Foreground="{StaticResource Accent}" Text="选择一项查看"/><StackPanel Orientation="Horizontal" Spacing="7"><Button x:Name="EditButton" Content="修改" IsEnabled="False" Background="{StaticResource Accent}" Foreground="White"/><Button x:Name="CancelButton" Content="取消" Visibility="Collapsed"/><Button x:Name="StateButton" Content="启用" IsEnabled="False"/><Button x:Name="DeleteButton" Content="删除" IsEnabled="False"/><Button x:Name="UndoButton" Content="撤销修改" IsEnabled="False"/><Button x:Name="RetryButton" Content="重试" Visibility="Collapsed"/></StackPanel></StackPanel>
    <Grid Grid.Row="3" RowSpacing="8"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="EntryEditor" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" ScrollViewer.VerticalScrollBarVisibility="Auto"/><TextBlock Grid.Row="1" Text="依据与适用条件" Style="{StaticResource Caption}"/><TextBox x:Name="EvidenceText" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" FontSize="12" ScrollViewer.VerticalScrollBarVisibility="Auto"/></Grid>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
